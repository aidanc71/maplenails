# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# Settings > Database > Connect > Session pooler tab (NOT "Direct connection" —
# that one is IPv6-only and fails to resolve on many home networks)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Settings > Data API (Project URL) and Settings > API Keys > Legacy > anon public
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

PORT=4000

# Developers > API keys > Secret key (test mode)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Where the frontend runs locally — used to build Stripe redirect URLs
FRONTEND_URL=http://localhost:5173
